# EasyVariants Backend Environment Variables
# Copy this file to .env and fill in real values. Do NOT commit .env.

# --- DATABASE ---
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/easyvariants?retryWrites=true&w=majority

# --- ADMIN AUTH ---
# Credentials for the admin dashboard (/admin)
ADMIN_EMAIL=admin@easyvariants.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Random secret used to sign admin JWT tokens. Use a long random string in production.
JWT_SECRET=use-a-long-random-string-here
JWT_EXPIRES_IN=7d

# --- MEDIA UPLOADS (CMS) — Cloudflare R2 ---
# Create an R2 bucket in Cloudflare → R2 → Create bucket.
# Create an API token with Object Read & Write for that bucket (R2 → Manage R2 API Tokens).
# Connect a custom domain (or R2.dev public URL) under bucket → Settings → Public access /
# Custom Domains. Example: https://media.yourdomain.com
#
# Required in Vercel production for image/video uploads. Locally, if these are unset,
# files save to public/uploads/cms/ instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL with no trailing slash (custom domain or r2.dev URL)
R2_PUBLIC_BASE_URL=
